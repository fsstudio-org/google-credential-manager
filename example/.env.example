# Web OAuth client ID — used on both platforms.
# Android: Credential Manager's serverClientId. iOS: GIDConfiguration.serverClientID,
# which makes the ID token's `aud` claim match Android.
EXPO_PUBLIC_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# iOS OAuth client ID — required on iOS, ignored on Android.
# The config plugin derives the reversed-client-ID URL scheme from this.
EXPO_PUBLIC_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
